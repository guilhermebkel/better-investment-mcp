{
  "name": "better-investment-mcp",
  "version": "0.0.5",
  "description": "MCP server that gives AI agents Brazilian asset data (prices, dividends, fundamentals, filings, FII reports) through one read-only SQL tool. Unofficial; not investment advice.",
  "license": "MIT",
  "author": "Guilherme Mota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermebkel/better-investment-mcp.git"
  },
  "homepage": "https://github.com/guilhermebkel/better-investment-mcp#readme",
  "bugs": {
    "url": "https://github.com/guilhermebkel/better-investment-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "investments",
    "b3",
    "fii",
    "duckdb",
    "sql"
  ],
  "type": "module",
  "bin": {
    "better-investment-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint --cache --cache-strategy content",
    "quality": "knip && jscpd && dpdm --no-warning --no-tree --exit-code circular:1 --transform src/**/*.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "ensure-deps": "node scripts/ensure-deps.mjs",
    "lint-staged": "lint-staged",
    "check:changed": "node scripts/check-changed.mjs",
    "check": "pnpm ensure-deps && pnpm typecheck && pnpm lint && pnpm quality && pnpm source:drift && pnpm check:tool-docs && pnpm test && pnpm build && pnpm check:pack && pnpm check:licenses && pnpm smoke",
    "check:pack": "node scripts/check-pack.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "source:drift": "node scripts/source-drift.mjs",
    "check:tool-docs": "node scripts/check-tool-docs.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "dpdm": "^4.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "node-html-parser": "9.0.7",
    "unpdf": "1.9.1"
  }
}
